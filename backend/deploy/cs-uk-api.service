# cs-uk-api systemd unit
#
# Install (with cs-uk-engine.service):
#   sudo cp deploy/cs-uk-engine.service deploy/cs-uk-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cs-uk-engine.service cs-uk-api.service
#
# Edit User= and WorkingDirectory= to match the host before enabling.
# No root on the host? The same units install as USER units with linger
# (DEPLOY.md §9).

[Unit]
Description=cs-uk-api - PS4 UK Stream backend (Ukrainian-dubbed catalog)
After=network-online.target cs-uk-engine.service
Wants=network-online.target cs-uk-engine.service

[Service]
Type=simple
User=rorschach
WorkingDirectory=/home/rorschach/UA flims/ps4-uk-stream/backend
# LAN-only service (ADR-0003 deployment assumption: one host, one process).
# Paths with spaces must stay quoted (systemd splits ExecStart on whitespace).
ExecStart="/home/rorschach/UA flims/ps4-uk-stream/backend/.venv/bin/uvicorn" cs_uk_api.main:app --host 0.0.0.0 --port 8003
Restart=on-failure
RestartSec=5

# TTL knobs (documented in CONTEXT.md "Cache contract"); defaults match
# the built-ins, uncomment to tune.
# Environment=CS_UK_CACHE_SEARCH=300
# Environment=CS_UK_CACHE_CONTENT=1800
# Environment=CS_UK_CACHE_POSTER=3600
# uakino needs a system Chromium (default /usr/bin/chromium).
# Environment=UAKINO_CHROMIUM=/usr/bin/chromium
# Torrent lane: engine address (BitPlay compose stack, docs/torrent-lane.md).
# Environment=CS_UK_TORRENT_ENGINE_URL=http://127.0.0.1:3347

[Install]
WantedBy=multi-user.target
