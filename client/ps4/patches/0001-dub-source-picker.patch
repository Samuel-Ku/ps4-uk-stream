+/// @brief the label the dub picker shows for one MediaSource (spec #276).
+static std::string dubLabel(const jellyfin::Source& source, size_t index) {
+    for (auto& stream : source.MediaStreams) {
+        if (stream.Type == jellyfin::streamTypeAudio && !stream.DisplayTitle.empty())
+            return stream.DisplayTitle;
+    }
+    if (!source.DisplayTitle.empty()) return source.DisplayTitle;
+    if (!source.Name.empty()) return source.Name;
+    return fmt::format("{} {}", "Озвучка", index + 1);
+}
+
+bool PlayerView::playSource(
+    const jellyfin::Source& source, const uint64_t seekTicks, const std::string& playSessionId) {
+    auto& mpv = MPVCore::instance();
+    auto& svr = AppConfig::instance().getUrl();
+
+    std::stringstream ssextra;
+#ifdef _DEBUG
+    for (auto& s : source.MediaStreams) {
+        brls::Logger::info("Track {} type {} => {}", s.Index, s.Type, s.DisplayTitle);
+    }
+#endif
+    ssextra << fmt::format("network-timeout={}", HTTP::TIMEOUT / 100);
+    if (seekTicks > 0) ssextra << ",start=" << misc::sec2Time(seekTicks / jellyfin::PLAYTICKS);
+    if (source.IsInfiniteStream) view->hideVideoProgressSlider();
+
+    if (source.IsRemote && MPVCore::FORCE_DIRECTPLAY) {
+        mpv.setUrl(source.Path, ssextra.str());
+        this->stream = source;
+        return true;
+    }
+
+    if (HTTP::PROXY_STATUS) ssextra << ",http-proxy=\"" << HTTP::PROXY << "\"";
+
+    if (source.SupportsDirectPlay || MPVCore::FORCE_DIRECTPLAY) {
+        std::string url = fmt::format(fmt::runtime(jellyfin::apiStream), this->itemId,
+            HTTP::encode_form({
+                {"static", "true"},
+                {"mediaSourceId", source.Id},
+                {"playSessionId", playSessionId},
+                {"tag", source.ETag},
+            }));
+        this->playMethod = jellyfin::methodDirectPlay;
+        mpv.setUrl(svr + url, ssextra.str());
+        this->stream = source;
+        return true;
+    }
+
+    if (source.SupportsTranscoding) {
+        this->playMethod = jellyfin::methodTranscode;
+        mpv.setUrl(svr + source.TranscodingUrl, ssextra.str());
+        this->stream = source;
+        return true;
+    }
+
+    return false;
+}
+
+void PlayerView::chooseSource(
+    const std::vector<jellyfin::Source>& sources, const uint64_t seekTicks, const std::string& playSessionId) {
+    // Picking a dub once keeps the rest of the binge on it: the player's
+    // next-episode path calls playMedia() again, and re-asking for every
+    // episode would be hostile.
+    if (!this->preferredDub.empty()) {
+        for (size_t i = 0; i < sources.size(); i++) {
+            if (dubLabel(sources[i], i) == this->preferredDub) {
+                this->playSource(sources[i], seekTicks, playSessionId);
+                return;
+            }
+        }
+    }
+
+    std::vector<std::string> labels;
+    labels.reserve(sources.size());
+    for (size_t i = 0; i < sources.size(); i++) labels.push_back(dubLabel(sources[i], i));
+
+    auto* dropdown = new brls::Dropdown(
+        "Озвучка", labels,
+        [this, sources, seekTicks, playSessionId](int selected) {
+            if (selected < 0 || selected >= (int)sources.size()) {
+                VideoView::close();
+                return;
+            }
+            this->preferredDub = dubLabel(sources[selected], selected);
+            this->playSource(sources[selected], seekTicks, playSessionId);
+        },
+        0, [](int selected) {
+            if (selected < 0) VideoView::close();
+        });
+    // B (cancel) would otherwise pop the picker and leave a black player:
+    // make it exit playback instead, so there is always a way out.
+    dropdown->registerAction("hints/cancel"_i18n, brls::BUTTON_B, [](brls::View*) {
+        brls::Application::popActivity(brls::TransitionAnimation::FADE, []() { VideoView::close(); });
+        return true;
+    });
+    brls::Application::pushActivity(new brls::Activity(dropdown), brls::TransitionAnimation::FADE);
+}
