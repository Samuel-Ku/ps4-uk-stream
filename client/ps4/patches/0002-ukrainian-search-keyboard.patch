+/// @brief erase the last UTF-8 code point.
+/// The stock Delete used ``pop_back()`` — one byte — which left half a
+/// Cyrillic letter behind (a Ukrainian letter is two bytes) and sent invalid
+/// UTF-8 to the server.
+static void eraseLastUtf8(std::string& text) {
+    if (text.empty()) return;
+    size_t pos = text.size() - 1;
+    while (pos > 0 && (static_cast<unsigned char>(text[pos]) & 0xC0) == 0x80) pos--;
+    text.erase(pos);
+}
